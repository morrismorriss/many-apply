{
  "manifest_version": 3,
  "name": "Many Apply: Save grant",
  "version": "0.3.0",
  "description": "Save a grant opportunity from any page into the Many Apply desktop app. Nothing leaves your computer.",
  "action": { "default_popup": "popup.html", "default_title": "Save to Many Apply" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47321/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "browser_specific_settings": {
    "gecko": {
      "id": "save-grant@many-apply",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
