{
  "manifest_version": 3,
  "name": "Many Apply: Save grant",
  "version": "0.1.0",
  "description": "Save a grant opportunity from any page into the Many Apply desktop app. Nothing leaves your computer.",
  "action": { "default_popup": "popup.html", "default_title": "Save to Many Apply" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47321/*"],
  "background": { "service_worker": "background.js", "type": "module" }
}
